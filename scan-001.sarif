              "id": "HEADERS-001",
              "name": "Missing header: Content-Security-Policy",
              "shortDescription": {
                "text": "Missing header: Content-Security-Policy"
              },
              "fullDescription": {
                "text": ""
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/693.html",
              "help": {
                "text": "Add a Content-Security-Policy header to restrict resource loading. Start with 'default-src \\'self\\''. Ref: https://owasp.org/www-project-secure-headers/",
                "markdown": "Add a Content-Security-Policy header to restrict resource loading. Start with 'default-src \\'self\\''. Ref: https://owasp.org/www-project-secure-headers/"
              },
              "properties": {
                "tags": [
                  "A05:2021",
                  "CWE-693"
                ],
                "severity": "medium",
                "precision": "medium"
              }
            },
            {
              "id": "SENSINFO-001",
              "name": "HTML comment with potentially sensitive content",
              "shortDescription": {
                "text": "HTML comment with potentially sensitive content"
              },
              "fullDescription": {
                "text": "Exposed internal information assists attackers in targeting further attacks with knowledge of technology stack, credentials, or paths."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/200.html",
              "help": {
                "text": "Review and remove HTML comments containing internal paths, version numbers, or developer notes before deploying to production.",
                "markdown": "Review and remove HTML comments containing internal paths, version numbers, or developer notes before deploying to production."
              },
              "properties": {
                "tags": [
                  "A02:2021",
                  "CWE-200"
                ],
                "severity": "low",
                "precision": "medium"
              }
            }
          ]
        }
      },
